                onBlur={handleDatasetBlur}
                className="input-base"
                placeholder="Ví dụ: 7"
              />
            </div>
            <div className="col-span-2 sm:col-span-1">
              <label className="block text-xs font-medium text-text-secondary mb-1.5">
