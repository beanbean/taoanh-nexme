<file path="app/src/app/globals.css">
@import "tailwindcss";

/* ============================================================
   Design Tokens - Apple/Emerald Theme
   ============================================================ */

@theme {
  /* Emerald brand palette */
  --color-brand-50: #ecfdf5;
  --color-brand-100: #d1fae5;
  --color-brand-200: #a7f3d0;
  --color-brand-300: #6ee7b7;
  --color-brand-400: #34d399;
  --color-brand-500: #22c55e;
  --color-brand-600: #16a34a;
  --color-brand-700: #15803d;

  /* Neutral palette (Apple-inspired warm grays) */
  --color-surface: #ffffff;
  --color-surface-secondary: #f9fafb;
  --color-surface-tertiary: #f3f4f6;
  --color-border: #d1d5db;
  --color-border-light: #e5e7eb;
  --color-border-hover: #9ca3af;

  --color-text-primary: #111827;
  --color-text-secondary: #4b5563;
  --color-text-tertiary: #6b7280;
  --color-text-inverse: #ffffff;

  /* Danger / destructive */
  --color-danger-50: #fef2f2;
  --color-danger-500: #ef4444;
  --color-danger-600: #dc2626;
  --color-danger-bg: #fee2e2;

  /* Shadows */
  --shadow-xs: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  --shadow-card: 0 1px 3px 0 rgb(0 0 0 / 0.06), 0 1px 2px -1px rgb(0 0 0 / 0.06);
  --shadow-elevated: 0 4px 12px -2px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.08);
  --shadow-modal: 0 20px 60px -12px rgb(0 0 0 / 0.2);

  /* Border radius */
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 20px;
  --radius-2xl: 24px;
  --radius-full: 9999px;

  /* Transitions */
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);

  /* Animation durations */
  --duration-fast: 150ms;
  --duration-normal: 250ms;
  --duration-slow: 350ms;
}

/* ============================================================
   Base / Reset
   ============================================================ */

* {
  -webkit-tap-highlight-color: transparent;
}

html {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

body {
  background-color: var(--color-surface-secondary);
  color: var(--color-text-primary);
}

/* ============================================================
   Utility Classes
   ============================================================ */

/* Apple-style frosted glass */
.glass {
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
}

/* Card component */
.card {
  background: var(--color-surface);
  border: 2px solid var(--color-border-light);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  transition: box-shadow var(--duration-normal) var(--ease-out),
              border-color var(--duration-normal) var(--ease-out);
}

.card:hover {
  box-shadow: var(--shadow-elevated);
  border-color: var(--color-border);
}

/* Player row card */
.player-row {
  border: 2px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 16px;
  background: var(--color-surface);
  transition: all var(--duration-fast) ease;
  box-shadow: var(--shadow-xs);
}

.player-row:hover {
  border-color: var(--color-brand-300);
  box-shadow: var(--shadow-elevated);
  background: linear-gradient(180deg, #fafffe, var(--color-surface));
}

/* Weight input field */
.weight-input {
  width: 100%;
  padding: 6px 4px;
  font-size: 0.75rem;
  text-align: center;
  border: 2px solid var(--color-border);
  border-radius: 6px;
  outline: none;
  transition: all var(--duration-fast) ease;
  background: var(--color-surface);
  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.04);
}

.weight-input::placeholder {
  color: var(--color-text-tertiary);
}

.weight-input:hover {
  border-color: var(--color-border-hover);
}

.weight-input:focus {
  border-color: var(--color-brand-500);
  box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.15);
}

/* Navigation dot buttons in image preview */
.nav-dot {
  width: 10px;
  height: 10px;
  border-radius: 999px;
  border: 2px solid var(--color-border);
  background: var(--color-surface);
  cursor: pointer;
  transition: all var(--duration-fast) ease;
  padding: 0;
}

.nav-dot:hover {
  border-color: var(--color-brand-400);
  transform: scale(1.2);
}

.nav-dot.active {
  width: 28px;
  background: var(--color-brand-500);
  border-color: var(--color-brand-500);
}

/* Close text button */
.btn-text-close {
  display: block;
  width: 100%;
  padding: 10px;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--color-text-secondary);
  background: var(--color-surface);
  border: 2px solid var(--color-border);
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: all var(--duration-fast) ease;
  text-align: center;
}

.btn-text-close:hover {
  background: var(--color-surface-tertiary);
  border-color: var(--color-border-hover);
  color: var(--color-text-primary);
  transform: translateY(-1px);
  box-shadow: var(--shadow-card);
}

/* Navigation arrow buttons */
.btn-nav-arrow {
  padding: 10px;
  background: var(--color-surface);
  border: 2px solid var(--color-border);
  border-radius: 999px;
  box-shadow: var(--shadow-card);
  color: var(--color-text-primary);
  cursor: pointer;
  transition: all var(--duration-fast) ease;
}

.btn-nav-arrow:hover {
  transform: scale(1.15);
  box-shadow: var(--shadow-elevated);
  border-color: var(--color-brand-400);
  background: var(--color-brand-50);
}

/* Form input base */
.input-base {
  width: 100%;
  padding: 10px 14px;
  background: var(--color-surface);
  border: 2px solid var(--color-border);
  border-radius: var(--radius-sm);
  font-size: 0.9375rem;
  line-height: 1.5;
  color: var(--color-text-primary);
  transition: border-color var(--duration-fast) ease,
              box-shadow var(--duration-fast) ease,
              background-color var(--duration-fast) ease;
  outline: none;
  box-shadow: var(--shadow-xs);
}

.input-base::placeholder {
  color: var(--color-text-tertiary);
}

.input-base:hover {
  border-color: var(--color-border-hover);
  background: #fafbfc;
}

.input-base:focus {
  border-color: var(--color-brand-500);
  box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.18);
  background: var(--color-surface);
}

/* Primary button - BIG GREEN - the main action */
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px 24px;
  background: linear-gradient(180deg, var(--color-brand-500), var(--color-brand-600));
  color: var(--color-text-inverse);
  font-weight: 700;
  font-size: 0.9375rem;
  border-radius: var(--radius-sm);
  border: 2px solid var(--color-brand-600);
  cursor: pointer;
  transition: all var(--duration-fast) ease;
  white-space: nowrap;
  box-shadow: 0 2px 4px rgba(22, 163, 74, 0.3), 0 1px 2px rgba(0, 0, 0, 0.1);
  text-shadow: 0 1px 1px rgba(0, 0, 0, 0.15);
  letter-spacing: 0.01em;
}

.btn-primary:hover {
  background: linear-gradient(180deg, var(--color-brand-400), var(--color-brand-500));
  border-color: var(--color-brand-500);
  transform: translateY(-1px) scale(1.01);
  box-shadow: 0 4px 12px rgba(22, 163, 74, 0.4), 0 2px 4px rgba(0, 0, 0, 0.12);
}

.btn-primary:active {
  transform: translateY(0) scale(0.99);
  box-shadow: 0 1px 2px rgba(22, 163, 74, 0.2);
}

.btn-primary:disabled {
  background: var(--color-border);
  border-color: var(--color-border);
  color: var(--color-text-tertiary);
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
  text-shadow: none;
  opacity: 0.7;
}

/* Secondary / outlined button - CLEAR BORDER */
.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 20px;
  background: var(--color-surface);
  color: var(--color-text-secondary);
  font-weight: 600;
  font-size: 0.9375rem;
  border-radius: var(--radius-sm);
  border: 2px solid var(--color-border);
  cursor: pointer;
  transition: all var(--duration-fast) ease;
  white-space: nowrap;
  box-shadow: var(--shadow-xs);
}

.btn-secondary:hover {
  background: var(--color-surface-tertiary);
  color: var(--color-text-primary);
  border-color: var(--color-border-hover);
  transform: translateY(-1px);
  box-shadow: var(--shadow-elevated);
}

.btn-secondary:active {
  transform: translateY(0);
  box-shadow: var(--shadow-xs);
}

/* Outlined action button - for Chon tat ca, Bo chon, etc */
.btn-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 8px 16px;
  background: var(--color-surface);
  color: var(--color-brand-700);
  font-weight: 600;
  font-size: 0.8125rem;
  border-radius: var(--radius-sm);
  border: 2px solid var(--color-brand-300);
  cursor: pointer;
  transition: all var(--duration-fast) ease;
  white-space: nowrap;
  box-shadow: var(--shadow-xs);
}

.btn-outline:hover {
  background: var(--color-brand-50);
  border-color: var(--color-brand-500);
  color: var(--color-brand-700);
  transform: translateY(-1px);
  box-shadow: 0 3px 8px rgba(34, 197, 94, 0.2);
}

.btn-outline:active {
  transform: translateY(0);
  background: var(--color-brand-100);
}

/* Ghost outline button - for secondary selection actions */
.btn-ghost-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 8px 16px;
  background: var(--color-surface);
  color: var(--color-text-secondary);
  font-weight: 600;
  font-size: 0.8125rem;
  border-radius: var(--radius-sm);
  border: 2px solid var(--color-border);
  cursor: pointer;
  transition: all var(--duration-fast) ease;
  white-space: nowrap;
  box-shadow: var(--shadow-xs);
}

.btn-ghost-outline:hover {
  background: var(--color-surface-tertiary);
  border-color: var(--color-border-hover);
  color: var(--color-text-primary);
  transform: translateY(-1px);
  box-shadow: var(--shadow-card);
}

.btn-ghost-outline:active {
  transform: translateY(0);
}

/* Danger button - RED & SCARY */
.btn-danger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px 24px;
  background: linear-gradient(180deg, #ef4444, #dc2626);
  color: var(--color-text-inverse);
  font-weight: 700;
  font-size: 0.9375rem;
  border-radius: var(--radius-sm);
  border: 2px solid var(--color-danger-600);
  cursor: pointer;
  transition: all var(--duration-fast) ease;
  white-space: nowrap;
  box-shadow: 0 2px 4px rgba(220, 38, 38, 0.3), 0 1px 2px rgba(0, 0, 0, 0.1);
  text-shadow: 0 1px 1px rgba(0, 0, 0, 0.15);
  letter-spacing: 0.01em;
}

.btn-danger:hover {
  background: linear-gradient(180deg, #f87171, #ef4444);
  border-color: var(--color-danger-500);
  transform: translateY(-1px) scale(1.01);
  box-shadow: 0 4px 12px rgba(220, 38, 38, 0.4), 0 2px 4px rgba(0, 0, 0, 0.12);
}

.btn-danger:active {
  transform: translateY(0) scale(0.99);
  box-shadow: 0 1px 2px rgba(220, 38, 38, 0.2);
}

/* Small danger button - for inline delete actions */
.btn-danger-sm {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 8px 12px;
  background: var(--color-danger-50);
  color: var(--color-danger-600);
  font-weight: 600;
  font-size: 0.75rem;
  border-radius: var(--radius-sm);
  border: 2px solid var(--color-danger-500);
  cursor: pointer;
  transition: all var(--duration-fast) ease;
  white-space: nowrap;
  box-shadow: var(--shadow-xs);
}

.btn-danger-sm:hover {
  background: var(--color-danger-500);
  color: var(--color-text-inverse);
  transform: translateY(-1px);
  box-shadow: 0 3px 8px rgba(239, 68, 68, 0.35);
}

.btn-danger-sm:active {
  transform: translateY(0);
}

/* Avatar upload button */
.btn-avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 8px 14px;
  background: var(--color-surface);
  color: var(--color-text-secondary);
  font-weight: 600;
  font-size: 0.75rem;
  border-radius: var(--radius-sm);
  border: 2px dashed var(--color-border);
  cursor: pointer;
  transition: all var(--duration-fast) ease;
  white-space: nowrap;
  box-shadow: var(--shadow-xs);
}

.btn-avatar:hover {
  border-color: var(--color-brand-400);
  border-style: solid;
  background: var(--color-brand-50);
