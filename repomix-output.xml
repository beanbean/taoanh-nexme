  background: var(--color-surface);
  color: var(--color-text-secondary);
  font-weight: 600;
  font-size: 0.75rem;
  border-radius: var(--radius-sm);
  border: 2px solid var(--color-border);
  cursor: pointer;
  transition: all var(--duration-fast) ease;
  white-space: nowrap;
  box-shadow: var(--shadow-xs);
}

.btn-header:hover {
